{
  "$schema": "http://json-schema.org/draft-07/schema",
  "importMap": "./import_map.json",
  "lint": {
    "include": ["src"],
    "exclude": [".github", "README.md"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "include": ["src"],
    "exclude": [".github", "README.md"],
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "tasks": {
    "check": "deno check src/mod.ts",
    "start": "deno run -P=default --unstable-otel --allow-scripts=npm:protobufjs ./src/mod.ts",
    "test": "deno test -P --coverage=coverage",
    "build": "deno compile -P --unstable-otel --allow-scripts=npm:protobufjs --output=./build/on-the-edge src/mod.ts"
  },
  "permissions": {
    "default": {
      "read": true,
      "env": true,
      "net": true,
      "sys": true,
      "run": true
    }
  },
  "test": {
    "permissions": {
      "read": true,
      "env": true,
      "net": true
    }
  },
  "compile": {
    "permissions": {
      "write": true,
      "read": true,
      "env": true,
      "net": true,
      "sys": true,
      "run": true
    }
  },
  "nodeModulesDir": "auto",
  "workspace": ["src/*"]
}
