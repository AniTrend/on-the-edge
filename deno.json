{
  "$schema": "http://json-schema.org/draft-07/schema",
  "importMap": "./src/import_map.json",
  "lint": {
    "include": ["src"],
    "exclude": [".github", "README.md"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "include": ["src"],
    "exclude": [".github", "README.md"],
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "tasks": {
    "check": "deno check src/mod.ts",
    "start": "deno run -P --unstable-otel --allow-scripts=npm:protobufjs ./src/mod.ts",
    "test": "deno test -P --coverage=coverage --allow-sys=osRelease",
    "build": "deno compile -P --unstable-otel --allow-scripts=npm:protobufjs --output=./build/on-the-edge src/mod.ts"
  },
  "permissions": {
    "default": {
      "read": [".env", "/.dockerenv"],
      "env": true,
      "net": true,
      "sys": ["osRelease", "uid", "gid", "hostname", "userInfo"],
      "run": ["/bin/sh"]
    }
  },
  "test": {
    "permissions": {
      "read": [".env"],
      "env": true
    }
  },
  "compile": {
    "permissions": {
      "read": [".env", "/.dockerenv"],
      "env": true,
      "net": true,
      "sys": ["osRelease", "uid", "gid", "hostname", "userInfo"],
      "run": ["/bin/sh"]
    }
  },
  "nodeModulesDir": "auto",
  "workspace": ["src/*"]
}
