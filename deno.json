{
  "$id": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "version": "0.1.0",
  "lint": {
    "include": ["src", "bootstrap.ts"],
    "exclude": [".github", "README.md"],
    "plugins": ["./lint/plugins/only-scoped-imports/plugin.ts"],
    "rules": {
      "include": ["anitrend/only-scoped-imports"],
      "exclude": ["require-await"],
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "include": ["src", "bootstrap.ts"],
    "exclude": [".github", "README.md"],
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "singleQuote": true,
    "proseWrap": "preserve"
  },
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "imports": {
    "@anitrend/request-client": "jsr:@anitrend/request-client@^0.1.4",
    "@danet/zod": "jsr:@danet/zod@^0.0.9",
    "@anatine/zod-openapi": "npm:@anatine/zod-openapi@^2.2.8",
    "@c4spar/mock-fetch": "jsr:@c4spar/mock-fetch@^1.0.0",
    "@db/redis": "jsr:@db/redis@^0.40.0",
    "@std/http": "jsr:@std/http@^1.0.24",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.6",
    "@std/testing": "jsr:@std/testing@^1.0.17",
    "@std/assert": "jsr:@std/assert@^1.0.18",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@onjara/optic": "jsr:@onjara/optic@^2.0.3",
    "@onjara/optic/formatters": "jsr:@onjara/optic@^2.0.3/formatters",
    "@growthbook/growthbook": "jsr:@growthbook/growthbook@^1.2.2",
    "@libs/xml": "jsr:@libs/xml@^7.0.3",
    "@negrel/webpush": "jsr:@negrel/webpush@^0.5.0",
    "@danet/core": "jsr:@danet/core@^2.11.0",
    "@danet/swagger": "jsr:@danet/swagger@^2.3.2",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.0",
    "@opentelemetry/sdk-node": "npm:@opentelemetry/sdk-node@^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "npm:@opentelemetry/exporter-trace-otlp-http@^0.219.0",
    "@opentelemetry/exporter-metrics-otlp-http": "npm:@opentelemetry/exporter-metrics-otlp-http@^0.219.0",
    "@opentelemetry/exporter-logs-otlp-http": "npm:@opentelemetry/exporter-logs-otlp-http@^0.219.0",
    "@opentelemetry/sdk-logs": "npm:@opentelemetry/sdk-logs@^0.219.0",
    "@opentelemetry/api-logs": "npm:@opentelemetry/api-logs@^0.219.0",
    "@opentelemetry/instrumentation-http": "npm:@opentelemetry/instrumentation-http@^0.219.0",
    "@opentelemetry/instrumentation-mongodb": "npm:@opentelemetry/instrumentation-mongodb@^0.71.0",
    "@opentelemetry/resources": "npm:@opentelemetry/resources@^2.5.1",
    "@opentelemetry/semantic-conventions": "npm:@opentelemetry/semantic-conventions@^1.39.0",
    "@opentelemetry/sdk-metrics": "npm:@opentelemetry/sdk-metrics@^2.5.1",
    "mongodb": "npm:mongodb@^6.21.0",
    "zod": "npm:zod@3.25.76"
  },
  "tasks": {
    "cache": "deno cache bootstrap.ts",
    "check": "deno check bootstrap.ts",
    "fmt:check": "deno fmt --check",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "deps:stable:show": "deno outdated --compatible",
    "deps:latest:show": "deno outdated --latest",
    "deps:stable:update": "deno outdated --compatible --update !npm:zod",
    "deps:latest:update": "deno outdated --latest --update !npm:zod",
    "dev": "deno -P bootstrap.ts",
    "dev:watch": "deno -P --watch-hmr bootstrap.ts",
    "swagger:generate": "deno -P src/swagger.ts",
    "swagger:validate": "deno -P --allow-read=.github/swagger-spec.json src/swagger-validate.ts",
    "test": "deno test -P --coverage=coverage --allow-sys=osRelease",
    "build": "deno compile -P --ignore-read --output=./build/edge bootstrap.ts"
  },
  "permissions": {
    "default": {
      "read": [".env", "/.dockerenv"],
      "write": [".github/swagger-spec.json"],
      "env": true,
      "net": true,
      "sys": ["osRelease", "uid", "gid", "hostname", "userInfo"],
      "run": ["/bin/sh"]
    }
  },
  "test": {
    "permissions": {
      "read": [".env"],
      "env": true,
      "run": ["/bin/sh"]
    },
    "include": ["**/*.test.ts", "**/*.spec.ts", "**/testing"]
  },
  "compile": {
    "permissions": {
      "env": true,
      "net": true,
      "sys": ["osRelease", "uid", "gid", "hostname", "userInfo"],
      "run": ["/bin/sh"]
    }
  },
  "nodeModulesDir": "auto",
  "workspace": ["src/*"]
}
